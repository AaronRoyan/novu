{
  "expo": {
    "name": "Novu",
    "slug": "novu",
    "scheme": "novu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/novu-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Novu uses your location to record your runs, including while the screen is locked."
      },
      "bundleIdentifier": "com.aaronroyan.novu.dev",
      "appleTeamId": "3V6477U83M"
    },
    "android": {
      "package": "com.aaronroyan.novu.dev",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "projectName": "Novu"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Novu uses your location to record your runs, including while the screen is locked.",
          "locationAlwaysAndWhenInUsePermission": "Novu uses your location to record your runs, including while the screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "./plugins/withMinimumPodsDeploymentTarget"
    ]
  }
}
